#!name=Talkatone TW
#!desc=Talkatone for Taiwanese v20261008.1
# Talkatone 在台灣使用中華電信固網出不去, 經測需要分流至行動網路才可正常連線, 並且內建Talkatone去廣告規則。
# 登入時除了 tktn.at / tktn.be, 還會連 inmobi / inner-active / mobilefuse / kochava 等 SDK,
# 這些必須和登入走同一個出口 (行動網路) 且不可封鎖, 否則 Wi-Fi 下會無法登入。

[Rule]
# Block Ad (不可封鎖 talkatone.list 中登入會用到的 SDK 網域)
DOMAIN-SUFFIX,ads.inmobi.com,REJECT-DROP
DOMAIN-SUFFIX,inmobicdn.net,REJECT-DROP
DOMAIN-SUFFIX,amazon-adsystem.com,REJECT-DROP
DOMAIN-SUFFIX,liftoff-creatives.io,REJECT-DROP
DOMAIN-SUFFIX,impression-asia.liftoff.io,REJECT-DROP
DOMAIN-SUFFIX,adsmoloco.com,REJECT-DROP
DOMAIN-SUFFIX,tappx.com,REJECT-DROP
DOMAIN-SUFFIX,criteo.com,REJECT-DROP
DOMAIN-SUFFIX,pubmatic.com,REJECT-DROP
DOMAIN-SUFFIX,smaato.net,REJECT-DROP
DOMAIN-SUFFIX,taboola.com,REJECT-DROP
DOMAIN-SUFFIX,impression.link,REJECT-DROP
DOMAIN-SUFFIX,skadnetworks.fyber.com,REJECT-DROP
DOMAIN-SUFFIX,view.adjust.com,REJECT-DROP
DOMAIN-SUFFIX,googleads.g.doubleclick.net,REJECT-DROP
DOMAIN-SUFFIX,googlesyndication.com,REJECT-DROP
DOMAIN-SUFFIX,fundingchoicesmessages.google.com,REJECT-DROP
DOMAIN-SUFFIX,adsappier.com,REJECT-DROP
DOMAIN-SUFFIX,appier.net,REJECT-DROP
DOMAIN-SUFFIX,appiersig.com,REJECT-DROP

# Talkatone 全部分流至行動網路
RULE-SET,https://raw.githubusercontent.com/liaojack8/Surge/refs/heads/master/rules/talkatone.list,CELLULAR-ONLY

[Host]
# CELLULAR-ONLY 會經行動網路查 DNS, Wi-Fi 下系統 DNS 是路由器內網 IP, 從行動網路連不到而 DNS timeout
# 改用公共 DNS 解析 Talkatone 相關網域
tktn.at = server:8.8.8.8
*.tktn.at = server:8.8.8.8
tktn.be = server:8.8.8.8
*.tktn.be = server:8.8.8.8
tktn.me = server:8.8.8.8
*.tktn.me = server:8.8.8.8
talkatone.com = server:8.8.8.8
*.talkatone.com = server:8.8.8.8
talkamobile.com = server:8.8.8.8
*.talkamobile.com = server:8.8.8.8
hcaptcha.com = server:8.8.8.8
*.hcaptcha.com = server:8.8.8.8
inmobi.com = server:8.8.8.8
*.inmobi.com = server:8.8.8.8
inner-active.mobi = server:8.8.8.8
*.inner-active.mobi = server:8.8.8.8
mobilefuse.com = server:8.8.8.8
*.mobilefuse.com = server:8.8.8.8
kochava.com = server:8.8.8.8
*.kochava.com = server:8.8.8.8
agkn.com = server:8.8.8.8
*.agkn.com = server:8.8.8.8
cohere.com = server:8.8.8.8
*.cohere.com = server:8.8.8.8
crashlytics.com = server:8.8.8.8
*.crashlytics.com = server:8.8.8.8
app-analytics-services.com = server:8.8.8.8
*.app-analytics-services.com = server:8.8.8.8
tenor.com = server:8.8.8.8
*.tenor.com = server:8.8.8.8
