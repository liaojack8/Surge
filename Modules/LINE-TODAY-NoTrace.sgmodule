#!name=Kill LINE TODAY 
#!desc=去除 LINE TODAY瀏覽時的登入狀態，阻擋噁心的新聞興趣追蹤 v20261006.02 - 需啟用 MitM over HTTP/2，需啟用重寫Header
#!system=ios
#!category=LINE Tweaks

[Rule]
# Block user page
URL-REGEX,^https:\/\/today\.line\.me\/api\/user(\/|\?|$),REJECT
# Block reader interaction and reply
URL-REGEX,^https:\/\/today\.line\.me\/webapi\/interaction(\/|\?|$),REJECT
URL-REGEX,^https:\/\/today\.line\.me\/webapi\/social-feed(\/|\?|$),REJECT
# Block Line ads
URL-REGEX,^https:\/\/a\.line\.me\/lgfp\/lad(\/|\?|$),REJECT
# 放行 loader.js: LINE Points、LINE TODAY 等頁面直接依賴它, 擋掉會讓頁面載入失敗 (含 media=today)
# loader 只負責載入 core/sdk_*.js, 實際的廣告 SDK 仍被擋下, loader 會自行吞掉載入失敗
URL-REGEX,^https:\/\/static\.line-scdn\.net(?::443)?\/lineads\/(?!edge\/r\/loader\.js),REJECT

# Block logging read history 
URL-REGEX,^https:\/\/today\.line\.me\/webapi\/logging(\/|\?|$),REJECT
URL-REGEX,^https:\/\/sentry-uit\.line-apps\.com\/,REJECT

[Header Rewrite]
#Remove token
http-request ^https:\/\/today\.line\.me\/ header-del cookie
http-request ^https:\/\/today\.line\.me\/ header-del x-line-liff-token
http-request ^https:\/\/today\.line\.me\/ header-del x-line-accesstoken
http-request ^https:\/\/today\.line\.me\/ header-del x-line-liff-accesstoken
http-request ^https:\/\/today\.line\.me\/ header-del baggage
# 靜態 JS 的條件請求回 304 時, 伺服器會在 HTTP/2 上夾帶 body, Surge MITM 報錯
# "HTTP/2 peer sent a body for a bodyless response" 導致頁面載入失敗; 移除條件標頭讓伺服器直接回 200
http-request ^https:\/\/today\.line\.me\/next\/[^\/]+\/_next\/static\/ header-del if-none-match
http-request ^https:\/\/today\.line\.me\/next\/[^\/]+\/_next\/static\/ header-del if-modified-since

[MITM]
hostname = %APPEND% today.line.me, a.line.me, static.line-scdn.net, sentry-uit.line-apps.com